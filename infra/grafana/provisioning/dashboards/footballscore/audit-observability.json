      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "title": "Audit requests per second",
      "targets": [
        {
          "range": true,
          "editorMode": "code",
          "expr": "sum by (job, uri) (rate(http_server_requests_seconds_count{job=~\"demo-rest|audit-service\",method=\"GET\",uri=\"/api/audit\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{job}} {{uri}}",
          "refId": "A"
        }
      ],
      "type": "timeseries",
      "fieldConfig": {
        "overrides": [],
        "defaults": {
          "unit": "reqps",
          "custom": {
            "spanNulls": false,
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "min": 0
        }
      },
      "gridPos": {
        "y": 0,
        "h": 9,
        "w": 8,
        "x": 0
      }
    },
    {
