          "editorMode": "code",
          "expr": "100 * (sum by (job, uri) (rate(http_server_requests_seconds_count{job=~\"demo-rest|audit-service\",method=\"GET\",uri=\"/api/audit\",status=~\"5..\"}[5m])) or on (job, uri) (0 * sum by (job, uri) (rate(http_server_requests_seconds_count{job=~\"demo-rest|audit-service\",method=\"GET\",uri=\"/api/audit\"}[5m])))) / clamp_min(sum by (job, uri) (rate(http_server_requests_seconds_count{job=~\"demo-rest|audit-service\",method=\"GET\",uri=\"/api/audit\"}[5m])), 0.000000001)",
